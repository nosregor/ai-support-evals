# Copy to .env. Everything works offline by default; no key needed.
# LLM_MODE=offline | ollama | live
LLM_MODE=offline

# For LLM_MODE=ollama (local model, e.g. Llama). Install Ollama, then: ollama pull llama3.1:8b
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://localhost:11434

# Only for LLM_MODE=live, and only with access approved by your company.
# ANTHROPIC_API_KEY=
