# Copy to .env. All settings are optional; these are the defaults.

# The model that answers customers (install with: ollama pull llama3.1:8b)
# OLLAMA_MODEL=llama3.1:8b

# The model that grades answers. Ideally stronger than OLLAMA_MODEL.
# OLLAMA_JUDGE_MODEL=llama3.1:8b

# OLLAMA_URL=http://localhost:11434
